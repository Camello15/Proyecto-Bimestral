    {
      "text": "%pyspark\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT etnia, SUM(talla) AS suma_talla, SUM(peso) AS suma_peso\r\n  FROM dfEtniaTallaPeso\r\n  WHERE etnia IS NOT NULL AND etnia !\u003d \u0027Sin información\u0027 AND talla IS NOT NULL AND peso IS NOT NULL AND etnia !\u003d \u0027Otra\u0027\r\n  GROUP BY etnia\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nimport numpy as np\r\nimport seaborn as sns\r\nimport matplotlib.pyplot as plt\r\n\r\n# Aplicar logaritmos\r\ndf_tmp[\"log2_talla\"] \u003d np.log2(df_tmp[\"suma_talla\"])\r\ndf_tmp[\"log10_peso\"] \u003d np.log10(df_tmp[\"suma_peso\"])\r\n\r\nplt.figure(figsize\u003d(10, 7))\r\n# Corrección para el primer gráfico\r\nsns.barplot(data\u003ddf_tmp, x\u003d\u0027etnia\u0027, y\u003d\u0027log10_peso\u0027, hue\u003d\u0027etnia\u0027, palette\u003d\u0027coolwarm\u0027, legend\u003dFalse)\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027) # Añadido ha\u003d\u0027right\u0027 para mejor alineación de etiquetas\r\nplt.ylabel(\"log₁₀(Suma de peso)\")\r\nplt.title(\"Suma del peso según etnia\")\r\nplt.tight_layout()\r\nplt.show()\r\n\r\nplt.figure(figsize\u003d(10, 7))\r\n# Corrección para el segundo gráfico\r\nsns.barplot(data\u003ddf_tmp, x\u003d\u0027etnia\u0027, y\u003d\u0027log2_talla\u0027, hue\u003d\u0027etnia\u0027, palette\u003d\u0027coolwarm\u0027, legend\u003dFalse)\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027) # Añadido ha\u003d\u0027right\u0027 para mejor alineación de etiquetas\r\nplt.ylabel(\"log₂(Suma de talla)\")\r\nplt.title(\"Suma de la talla según etnia\")\r\nplt.tight_layout()\r\nplt.show()\r\n",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 03:42:33.143",
      "progress": 0,
