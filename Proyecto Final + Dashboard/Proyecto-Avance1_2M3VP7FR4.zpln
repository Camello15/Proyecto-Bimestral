    },
    {
      "text": "%pyspark\ntmp_view_nivinst \u003d spark.sql(\"\"\"\n  SELECT niv_inst, COUNT(*) AS cantidad\n  FROM dfNacidosNivelInstruccion\n  WHERE niv_inst IS NOT NULL AND niv_inst !\u003d \u0027Sin información\u0027\n  GROUP BY niv_inst\n\"\"\")\ndf_nivinst_count \u003d tmp_view_nivinst.toPandas()\n\nimport seaborn as sns\nimport matplotlib.pyplot as plt\nimport numpy as np\n\n# Ordenar por cantidad descendente (opcional)\ndf_nivinst_count \u003d df_nivinst_count.sort_values(by\u003d\"cantidad\", ascending\u003dFalse)\n\n# Calcular log base 10\ndf_nivinst_count[\"log_cantidad\"] \u003d np.log10(df_nivinst_count[\"cantidad\"])\n\n# Tamaño del gráfico\nplt.figure(figsize\u003d(12, 6))\n\n# Gráfico de barras con valores logarítmicos\n# Corrección del warning: asignar \u0027x\u0027 a \u0027hue\u0027 y ocultar la leyenda\nsns.barplot(data\u003ddf_nivinst_count, x\u003d\"niv_inst\", y\u003d\"log_cantidad\", hue\u003d\"niv_inst\", palette\u003d\"magma\", legend\u003dFalse)\n\n# Estética\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027) # Añadido ha\u003d\u0027right\u0027 para mejor alineación\nplt.xlabel(\"Nivel de Instrucción de la Madre\")\nplt.ylabel(\"log₁₀(Cantidad de Nacimientos)\")\nplt.title(\"Cantidad de Nacimientos por Nivel de Instrucción (Escala Logarítmica)\")\n\nplt.tight_layout()\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 02:54:32.913",
      "progress": 0,
      "config": {
        "editorSetting": {
