    {
      "text": "%pyspark\r\ntmp_view_pemb \u003d spark.sql(\"\"\"\r\n  SELECT p_emb, num_emb, hij_nacm\r\n  FROM dfNacidosProductoEmbarazo\r\n  WHERE p_emb IS NOT NULL\r\n        AND num_emb IS NOT NULL\r\n        AND hij_nacm IS NOT NULL\r\n        AND p_emb !\u003d \u0027Sin información\u0027\r\n\"\"\")\r\ndf_pemb \u003d tmp_view_pemb.toPandas()\r\n\r\n# Agrupación por tipo de embarazo\r\ndf_grouped \u003d df_pemb.groupby(\"p_emb\").agg({\r\n    \"num_emb\": \"sum\",\r\n    \"hij_nacm\": \"sum\"\r\n}).reset_index()\r\n\r\n# Aplicar log2 a las cantidades (suma de embarazos e hijos nacidos)\r\n# Corrección para \u0027divide by zero\u0027: Sumar 1 antes de aplicar log2\r\ndf_grouped[\"log2_num_emb\"] \u003d np.log2(df_grouped[\"num_emb\"] + 1)\r\ndf_grouped[\"log2_hij_nacm\"] \u003d np.log2(df_grouped[\"hij_nacm\"] + 1) # También para hij_nacm\r\n\r\nplt.figure(figsize\u003d(12, 6))\r\n# Corrección para el FutureWarning\r\nsns.barplot(data\u003ddf_grouped, x\u003d\"p_emb\", y\u003d\"log2_num_emb\", hue\u003d\"p_emb\", palette\u003d\"plasma\", legend\u003dFalse)\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\r\nplt.xlabel(\"Producto del Embarazo\")\r\nplt.ylabel(\"log₂(Total de embarazos + 1)\") # Actualizar etiqueta del eje para reflejar +1\r\nplt.title(\"Logaritmo base 2 del Total de embarazos por tipo de embarazo\")\r\nplt.tight_layout()\r\nplt.show()\r\n\r\nplt.figure(figsize\u003d(12, 6))\r\nsns.barplot(data\u003ddf_grouped, x\u003d\"p_emb\", y\u003d\"log2_hij_nacm\", hue\u003d\"p_emb\", palette\u003d\"mako\", legend\u003dFalse)\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\r\nplt.xlabel(\"Producto del Embarazo\")\r\nplt.ylabel(\"log₂(Total de hijos nacidos muertos + 1)\")\r\nplt.title(\"Logaritmo base 2 del Total de hijos nacidos muertos por tipo de embarazo\")\r\nplt.tight_layout()\r\nplt.show()\r\n",
      "user": "anonymous",
