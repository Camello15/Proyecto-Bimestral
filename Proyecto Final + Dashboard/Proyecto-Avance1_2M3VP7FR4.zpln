      "text": "%pyspark\r\ntop_provs \u003d spark.sql(\"\"\"\r\n  SELECT prov_res, COUNT(*) AS cnt\r\n  FROM dfHijosMuertosNivelProv\r\n  WHERE prov_res IS NOT NULL AND prov_res !\u003d \u0027Sin información\u0027\r\n  GROUP BY prov_res ORDER BY cnt DESC LIMIT 10\r\n\"\"\").toPandas()[\u0027prov_res\u0027].tolist()\r\n\r\ntmp \u003d spark.sql(f\"\"\"\r\n  SELECT prov_res, niv_inst, AVG(hij_nacm) AS prom_hijos_muertos\r\n  FROM dfHijosMuertosNivelProv\r\n  WHERE prov_res IN ({\u0027,\u0027.join([\"\u0027\" + p + \"\u0027\" for p in top_provs])})\r\n    AND niv_inst IS NOT NULL AND niv_inst !\u003d \u0027Sin información\u0027\r\n    AND hij_nacm IS NOT NULL\r\n  GROUP BY prov_res, niv_inst\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\ndf_pivot \u003d df_tmp.pivot(index\u003d\u0027prov_res\u0027, columns\u003d\u0027niv_inst\u0027, values\u003d\u0027prom_hijos_muertos\u0027).fillna(0)\r\n\r\nplt.figure(figsize\u003d(14,8))\r\nsns.heatmap(df_pivot, annot\u003dTrue, cmap\u003d\u0027Reds\u0027)\r\nplt.title(\"Promedio hijos muertos por nivel instrucción y provincia residencia (Top 10 provincias)\")\r\nplt.xlabel(\"Nivel de instrucción\")\r\nplt.ylabel(\"Provincia de residencia\")\r\nplt.tight_layout()\r\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 02:52:33.846",
      "progress": 0,
      "config": {
