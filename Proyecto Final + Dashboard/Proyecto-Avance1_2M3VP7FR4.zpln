      "status": "READY"
    },
    {
      "text": "%md\n### Cuartiles",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
