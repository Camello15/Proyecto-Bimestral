      "text": "%pyspark\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT sabe_leer, tipo_part, AVG(sem_gest) AS sem_prom\r\n  FROM dfSabeLeerPartoSem\r\n  WHERE sabe_leer IS NOT NULL AND sabe_leer !\u003d \u0027Sin información\u0027\r\n    AND tipo_part IS NOT NULL AND tipo_part !\u003d \u0027Sin información\u0027\r\n    AND sem_gest IS NOT NULL\r\n  GROUP BY sabe_leer, tipo_part\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nplt.figure(figsize\u003d(12,6))\r\nsns.barplot(data\u003ddf_tmp, x\u003d\u0027sabe_leer\u0027, y\u003d\u0027sem_prom\u0027, hue\u003d\u0027tipo_part\u0027)\r\nplt.xticks(rotation\u003d45)\r\nplt.ylabel(\"Semanas promedio de gestación\")\r\nplt.title(\"Semanas de gestación según saber leer y tipo de parto\")\r\nplt.tight_layout()\r\nplt.show()",
