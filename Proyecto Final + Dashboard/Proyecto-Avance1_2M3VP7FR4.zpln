      "text": "%pyspark\r\ntop_lugares \u003d spark.sql(\"\"\"\r\n  SELECT lugar_ocur, COUNT(*) AS cnt\r\n  FROM dfEstCivilHijosLugar\r\n  WHERE lugar_ocur IS NOT NULL AND lugar_ocur !\u003d \u0027Sin información\u0027 AND lugar_ocur !\u003d \u0027Otro\u0027\r\n  GROUP BY lugar_ocur ORDER BY cnt DESC LIMIT 10\r\n\"\"\").toPandas()[\u0027lugar_ocur\u0027].tolist()\r\n\r\ntmp \u003d spark.sql(f\"\"\"\r\n  SELECT est_civil, lugar_ocur, AVG(hij_vivm) AS prom_hijos\r\n  FROM dfEstCivilHijosLugar\r\n  WHERE lugar_ocur IN ({\u0027,\u0027.join([\"\u0027\" + l + \"\u0027\" for l in top_lugares])})\r\n    AND est_civil IS NOT NULL AND est_civil !\u003d \u0027Sin información\u0027 AND est_civil !\u003d \u0027Otro\u0027\r\n    AND hij_vivm IS NOT NULL\r\n  GROUP BY est_civil, lugar_ocur\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nplt.figure(figsize\u003d(14,7))\r\nsns.barplot(data\u003ddf_tmp, x\u003d\u0027est_civil\u0027, y\u003d\u0027prom_hijos\u0027, hue\u003d\u0027lugar_ocur\u0027)\r\nplt.xticks(rotation\u003d45)\r\nplt.ylabel(\"Promedio hijos vivos\")\r\nplt.title(\"Promedio hijos vivos por estado civil y lugar de ocurrencia (Top 10 lugares)\")\r\nplt.tight_layout()\r\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 02:52:53.100",
