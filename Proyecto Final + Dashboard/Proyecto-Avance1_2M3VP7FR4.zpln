      "jobName": "paragraph_1753661732822_1048387573",
      "id": "paragraph_1752713868782_1370243227",
      "dateCreated": "2025-07-28 00:15:32.822",
      "status": "READY"
    },
    {
      "text": "val dfSinOutliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"apgar5\" \u003e\u003d limiteInfDS \u0026\u0026 $\"apgar5\" \u003c\u003d limiteSupDS)",
