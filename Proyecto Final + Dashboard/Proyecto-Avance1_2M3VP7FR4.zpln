    {
      "text": "%md \n# Examen Bimestral Segundo Bimestre\n",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.825",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "markdown",
          "editOnDblClick": true,
          "completionKey": "TAB",
          "completionSupport": false
