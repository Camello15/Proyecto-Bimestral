      "id": "paragraph_1752713180681_1634953486",
      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val stats \u003d dfNacidosCleanFinal\n\t.select(\n\t\tavg(\"apgar5\").as(\"media\"),\n\t\tstddev(\"apgar5\").as(\"desviacion_estandar\")\n\t).first",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.821",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionSupport": true,
          "completionKey": "TAB"
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m \u003d [9.019822999685006,0.6620257008977671]\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732821_1164581580",
      "id": "paragraph_1752713278558_232087594",
      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val media \u003d stats.getAs[Double](\"media\")\r\nval desStand \u003d stats.getAs[Double](\"desviacion_estandar\")\r\nval umbralDesviacion \u003d 2.0",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.822",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 9.019822999685006\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 0.6620257008977671\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 2.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732821_978573524",
      "id": "paragraph_1752713815700_1607462913",
      "dateCreated": "2025-07-28 00:15:32.822",
      "status": "READY"
    },
    {
      "text": "val limiteInfDS \u003d media - umbralDesviacion * desStand\r\nval limiteSupDS \u003d media + umbralDesviacion * desStand",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.822",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
