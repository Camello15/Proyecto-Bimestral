      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mq1\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 9.0\n\u001b[1m\u001b[34mq3\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 9.0\n\u001b[1m\u001b[34miqr\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 0.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732822_1091565314",
      "id": "paragraph_1752713957276_2022438005",
      "dateCreated": "2025-07-28 00:15:32.822",
      "status": "READY"
    },
    {
      "text": "val limiteInferiorIQR \u003d q1 - 1.5 * iqr\r\nval limiteSuperiorIQR \u003d q3 + 1.5 * iqr",
