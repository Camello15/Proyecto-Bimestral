      "text": "val dfConEdadBinnedPesoTalla \u003d dfNacidosCleanFinal.withColumn(\r\n    \"grupo_edad_mad\",\r\n    when(col(\"edad_mad\").isNull, \"Sin Informacion Edad\") // Manejar nulos en edad_mad\r\n    .when(col(\"edad_mad\") \u003c 18, \"Menor de 18\")\r\n    .when(col(\"edad_mad\") \u003e\u003d 18 \u0026\u0026 col(\"edad_mad\") \u003c\u003d 24, \"18-24\")\r\n    .when(col(\"edad_mad\") \u003e\u003d 25 \u0026\u0026 col(\"edad_mad\") \u003c\u003d 34, \"25-34\")\r\n    .when(col(\"edad_mad\") \u003e\u003d 35 \u0026\u0026 col(\"edad_mad\") \u003c\u003d 44, \"35-44\")\r\n    .when(col(\"edad_mad\") \u003e\u003d 45, \"45 o mas\")\r\n    .otherwise(\"Sin Informacion Edad\") // Para cualquier otro caso\r\n)\r\n\r\n// Crear una vista temporal para PySpark\r\ndfConEdadBinnedPesoTalla.createOrReplaceTempView(\"dfFullWithBinnedAge\")",
