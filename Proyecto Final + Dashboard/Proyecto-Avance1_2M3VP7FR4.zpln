    {
      "text": "%pyspark\r\ntop_areas \u003d spark.sql(\"\"\"\r\n  SELECT area_res, COUNT(*) AS cnt\r\n  FROM dfControlesAreaNum\r\n  WHERE area_res IS NOT NULL AND area_res !\u003d \u0027Sin información\u0027\r\n  GROUP BY area_res ORDER BY cnt DESC LIMIT 10\r\n\"\"\").toPandas()[\u0027area_res\u0027].tolist()\r\n\r\ntmp \u003d spark.sql(f\"\"\"\r\n  SELECT area_res, num_emb, AVG(con_pren) AS avg_con_pren\r\n  FROM dfControlesAreaNum\r\n  WHERE area_res IN ({\u0027,\u0027.join([\"\u0027\" + a + \"\u0027\" for a in top_areas])})\r\n    AND con_pren IS NOT NULL AND num_emb IS NOT NULL\r\n  GROUP BY area_res, num_emb\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nplt.figure(figsize\u003d(14,7))\r\nsns.barplot(data\u003ddf_tmp, x\u003d\u0027area_res\u0027, y\u003d\u0027avg_con_pren\u0027, hue\u003d\u0027num_emb\u0027)\r\nplt.xticks(rotation\u003d45)\r\nplt.ylabel(\"Promedio controles prenatales\")\r\nplt.xlabel(\"Área de residencia (Top 10)\")\r\nplt.title(\"Controles prenatales promedio según área de residencia y número de embarazos\")\r\nplt.tight_layout()\r\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 02:54:21.373",
      "progress": 0,
      "config": {
