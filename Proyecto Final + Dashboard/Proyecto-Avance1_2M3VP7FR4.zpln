          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_821590094",
      "id": "paragraph_1752713475325_1791799333",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val stats \u003d dfNacidosCleanFinal\n\t.select(\n\t\tavg(\"talla\").as(\"media\"),\n\t\tstddev(\"talla\").as(\"desviacion_estandar\")\n\t).first",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionSupport": true,
          "completionKey": "TAB"
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m \u003d [48.54522348326832,2.4648283275783904]\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_1856897152",
      "id": "paragraph_1752713538267_1331226944",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val media \u003d stats.getAs[Double](\"media\")\r\nval desStand \u003d stats.getAs[Double](\"desviacion_estandar\")\r\nval umbralDesviacion \u003d 2.0",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 48.54522348326832\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 2.4648283275783904\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 2.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_545340650",
      "id": "paragraph_1752713601333_2069325503",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val limiteInfDS \u003d media - umbralDesviacion * desStand\r\nval limiteSupDS \u003d media + umbralDesviacion * desStand",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
