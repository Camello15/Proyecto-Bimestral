      "text": "%pyspark\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT prov_nac, tipo_part, COUNT(*) AS count, AVG(edad_mad) AS edad_prom\r\n  FROM dfPartoProvinciaEdad\r\n  WHERE prov_nac IS NOT NULL AND tipo_part IS NOT NULL AND edad_mad IS NOT NULL\r\n        AND tipo_part !\u003d \u0027Sin información\u0027 AND prov_nac !\u003d \u0027Sin información\u0027\r\n  GROUP BY prov_nac, tipo_part\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nplt.figure(figsize\u003d(14,7))\r\nsns.barplot(data\u003ddf_tmp, x\u003d\"prov_nac\", y\u003d\"count\", hue\u003d\"tipo_part\")\r\nplt.xticks(rotation\u003d90)\r\nplt.xlabel(\"Provincia de nacimiento\")\r\nplt.ylabel(\"Cantidad de partos\")\r\nplt.title(\"Conteo de tipo de parto por provincia de nacimiento\")\r\nplt.tight_layout()\r\nplt.show()\r\n\r\n# Opcional para edad promedio:\r\nimport numpy as np\r\nplt.figure(figsize\u003d(14,4))\r\nsns.scatterplot(data\u003ddf_tmp, x\u003d\"prov_nac\", y\u003d\"edad_prom\", hue\u003d\"tipo_part\", palette\u003d\"deep\", s\u003d100)\r\nplt.xticks(rotation\u003d90)\r\nplt.xlabel(\"Provincia de nacimiento\")\r\nplt.ylabel(\"Edad promedio de la madre\")\r\nplt.title(\"Edad promedio de la madre por tipo de parto y provincia\")\r\nplt.tight_layout()\r\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 02:54:26.144",
