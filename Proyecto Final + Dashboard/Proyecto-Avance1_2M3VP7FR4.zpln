      "status": "READY"
    },
    {
      "text": "val q1 \u003d cuartiles(0)\r\nval q3 \u003d cuartiles(1)\r\nval iqr \u003d q3 - q1",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.822",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
