      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val cuartiles \u003d dfNacidosCleanFinal.stat.approxQuantile(\r\n\"apgar1\", Array(0.25, 0.75), 0.01 //los percentiles 0.25 y 0.75 para Q1 y Q3\r\n)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.821",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mcuartiles\u001b[0m: \u001b[1m\u001b[32mArray[Double]\u001b[0m \u003d Array(8.0, 9.0)\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732821_810015351",
      "id": "paragraph_1752712923475_1388977319",
      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val q1 \u003d cuartiles(0)\r\nval q3 \u003d cuartiles(1)\r\nval iqr \u003d q3 - q1",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.821",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mq1\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 8.0\n\u001b[1m\u001b[34mq3\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 9.0\n\u001b[1m\u001b[34miqr\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 1.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732821_452858424",
      "id": "paragraph_1752713319912_868338716",
      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val limiteInferiorIQR \u003d q1 - 1.5 * iqr\r\nval limiteSuperiorIQR \u003d q3 + 1.5 * iqr",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.821",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
