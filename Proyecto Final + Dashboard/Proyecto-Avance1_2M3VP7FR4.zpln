    {
      "text": "val stats \u003d dfNacidosCleanFinal\r\n\t.select(\r\n\t\tavg(\"apgar1\").as(\"media\"),\r\n\t\tstddev(\"apgar1\").as(\"desviacion_estandar\")\r\n\t).first",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.820",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
