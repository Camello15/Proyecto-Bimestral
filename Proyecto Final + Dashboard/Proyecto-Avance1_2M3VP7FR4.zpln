            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mlimiteInfDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 43.61556682811154\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 53.47488013842511\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_221915415",
      "id": "paragraph_1752713619061_1852079276",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val outliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"talla\" \u003c limiteInfDS || $\"talla\" \u003e limiteSupDS)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
