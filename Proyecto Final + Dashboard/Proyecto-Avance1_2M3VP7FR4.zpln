      "status": "READY"
    },
    {
      "text": "val outliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"peso\" \u003c limiteInfDS || $\"peso\" \u003e limiteSupDS)",
      "user": "anonymous",
