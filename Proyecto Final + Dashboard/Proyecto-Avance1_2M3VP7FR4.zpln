      "text": "%pyspark\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT mes_nac, sexo, AVG(sem_gest) AS sem_prom\r\n  FROM dfMesSemGestSexo\r\n  WHERE mes_nac IS NOT NULL AND sexo IS NOT NULL AND sem_gest IS NOT NULL\r\n        AND mes_nac !\u003d \u0027Sin información\u0027\r\n  GROUP BY mes_nac, sexo\r\n  ORDER BY mes_nac\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\nplt.figure(figsize\u003d(12,6))\r\nsns.lineplot(data\u003ddf_tmp, x\u003d\u0027mes_nac\u0027, y\u003d\u0027sem_prom\u0027, hue\u003d\u0027sexo\u0027, marker\u003d\u0027o\u0027)\r\nplt.xlabel(\"Mes de nacimiento\")\r\nplt.ylabel(\"Semanas promedio de gestación\")\r\nplt.title(\"Semanas de gestación promedio por mes y sexo\")\r\nplt.tight_layout()\r\nplt.show()",
