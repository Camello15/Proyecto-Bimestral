    {
      "text": "import org.apache.spark.sql.functions._\r\n\r\nval textoObjetivo \u003d \"Sin información\"\r\n\r\n// Lista de columnas enteras donde vamos a buscar el texto\r\nval columnasEnteras \u003d Seq(\r\n  \"anio_insc\", \"dia_insc\", \"talla\", \"peso\", \"sem_gest\", \"apgar1\", \"apgar5\",\r\n  \"anio_mad\", \"dia_mad\", \"edad_mad\", \"con_pren\", \"num_emb\", \"num_par\",\r\n  \"hij_vivm\", \"hij_nacm\"\r\n)\r\n\r\n// Contar \"Sin información\" por cada columna indicada\r\nval conteos \u003d columnasEnteras.map { colName \u003d\u003e\r\n  val count \u003d dfNacidosClean.filter(col(colName) \u003d\u003d\u003d textoObjetivo).count()\r\n  (colName, count)\r\n}\r\n\r\n// Mostrar resultados\r\nconteos.foreach { case (columna, cantidad) \u003d\u003e\r\n  println(s\"Columna: $columna \u003d\u003e \u0027Sin información\u0027 aparece $cantidad veces\")\r\n}",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:18:02.814",
      "progress": 0,
