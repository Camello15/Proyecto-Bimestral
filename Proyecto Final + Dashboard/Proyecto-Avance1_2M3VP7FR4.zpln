    },
    {
      "text": "val stats \u003d dfNacidosCleanFinal\n  .select(\n    avg(\"peso\").as(\"media\"),\n    stddev(\"peso\").as(\"desviacion_estandar\")\n  ).first()",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.823",
      "progress": 0,
      "config": {
        "tableHide": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionSupport": true,
          "completionKey": "TAB"
        },
        "colWidth": 12.0,
        "fontSize": 9.0,
        "editorHide": false,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m \u003d [3068.7153236346126,505.60786527826025]\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732823_540802870",
      "id": "paragraph_1752714569979_875094036",
      "dateCreated": "2025-07-28 00:15:32.823",
      "status": "READY"
    },
    {
      "text": "val media \u003d stats.getAs[Double](\"media\")\r\nval desStand \u003d stats.getAs[Double](\"desviacion_estandar\")\r\nval umbralDesviacion \u003d 2.0",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.823",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 3068.7153236346126\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 505.60786527826025\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 2.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732823_539739637",
      "id": "paragraph_1752714579281_1530736053",
      "dateCreated": "2025-07-28 00:15:32.823",
      "status": "READY"
    },
    {
      "text": "val limiteInfDS \u003d media - umbralDesviacion * desStand\r\nval limiteSupDS \u003d media + umbralDesviacion * desStand",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.823",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
