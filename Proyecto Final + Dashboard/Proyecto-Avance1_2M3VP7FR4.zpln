            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mlimiteInfDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 7.695771597889472\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 10.34387440148054\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732822_1412386102",
      "id": "paragraph_1752713847848_483600861",
      "dateCreated": "2025-07-28 00:15:32.822",
      "status": "READY"
    },
    {
      "text": "val outliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"apgar5\" \u003c limiteInfDS || $\"apgar5\" \u003e limiteSupDS)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.822",
      "progress": 0,
      "config": {
