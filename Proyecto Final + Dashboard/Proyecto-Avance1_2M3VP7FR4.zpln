      "status": "READY"
    },
    {
      "text": "val cuartiles \u003d dfNacidosCleanFinal.stat.approxQuantile(\n\"apgar5\", Array(0.25, 0.75), 0.01 //los percentiles 0.25 y 0.75 para Q1 y Q3\n)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.822",
      "progress": 0,
      "config": {
        "tableHide": true,
        "editorSetting": {
