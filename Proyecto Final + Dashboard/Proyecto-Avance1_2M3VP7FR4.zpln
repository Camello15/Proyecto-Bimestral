    {
      "text": "%pyspark\r\ntop_nac \u003d spark.sql(\"\"\"\r\n  SELECT nac_mad, COUNT(*) AS cnt\r\n  FROM dfNacMadEdadNum\r\n  WHERE nac_mad IS NOT NULL AND nac_mad !\u003d \u0027Sin información\u0027\r\n  GROUP BY nac_mad ORDER BY cnt DESC LIMIT 10\r\n\"\"\").toPandas()[\u0027nac_mad\u0027].tolist()\r\n\r\ntmp \u003d spark.sql(f\"\"\"\r\n  SELECT nac_mad, AVG(edad_mad) AS edad_prom, AVG(num_emb) AS emb_prom\r\n  FROM dfNacMadEdadNum\r\n  WHERE nac_mad IN ({\u0027,\u0027.join([\"\u0027\" + n + \"\u0027\" for n in top_nac])})\r\n  GROUP BY nac_mad\r\n\"\"\")\r\ndf_tmp \u003d tmp.toPandas()\r\n\r\n# Consulta para obtener los 10 países con más registros y sus conteos\r\ntop_nac_log \u003d spark.sql(\"\"\"\r\n  SELECT nac_mad, COUNT(*) AS cnt\r\n  FROM dfNacMadEdadNum\r\n  WHERE nac_mad IS NOT NULL AND nac_mad !\u003d \u0027Sin información\u0027\r\n  GROUP BY nac_mad\r\n  ORDER BY cnt DESC\r\n  LIMIT 10\r\n\"\"\").toPandas()\r\n\r\n# Calcular el log base 10 del conteo\r\ntop_nac_log[\u0027log10_cnt\u0027] \u003d np.log10(top_nac_log[\u0027cnt\u0027])\r\n\r\n# Gráfica\r\nplt.figure(figsize\u003d(10,6))\r\nsns.barplot(data\u003dtop_nac_log, x\u003d\u0027nac_mad\u0027, y\u003d\u0027log10_cnt\u0027, hue\u003d\u0027nac_mad\u0027, palette\u003d\u0027viridis\u0027, legend\u003dFalse)\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\r\nplt.title(\"Log₁₀ del Número de registros por nacionalidad (Top 10)\")\r\nplt.ylabel(\"Cantidad de registros\")\r\nplt.xlabel(\"Nacionalidad de la madre\")\r\nplt.tight_layout()\r\nplt.show()\r\n\r\n",
      "user": "anonymous",
