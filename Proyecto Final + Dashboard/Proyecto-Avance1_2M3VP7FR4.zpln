      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mlimiteInferiorIQR\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 6.5\n\u001b[1m\u001b[34mlimiteSuperiorIQR\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 10.5\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732821_1955784368",
      "id": "paragraph_1752713325357_1096348945",
      "dateCreated": "2025-07-28 00:15:32.821",
      "status": "READY"
    },
    {
      "text": "val outliersIQR \u003d dfNacidosCleanFinal.filter(\r\n\tcol(\"apgar1\") \u003c limiteInferiorIQR || col(\"apgar1\") \u003e limiteSuperiorIQR\r\n)",
      "user": "anonymous",
