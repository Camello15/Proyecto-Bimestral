      "jobName": "paragraph_1753661732824_1285685346",
      "id": "paragraph_1752713629096_715581234",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val dfSinOutliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"talla\" \u003e\u003d limiteInfDS \u0026\u0026 $\"talla\" \u003c\u003d limiteSupDS)",
