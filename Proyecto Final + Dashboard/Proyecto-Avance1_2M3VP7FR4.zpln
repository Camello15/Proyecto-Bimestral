      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "HTML",
            "data": "\u003cdiv class\u003d\"markdown-body\"\u003e\n\u003ch1\u003eExamen Bimestral Segundo Bimestre\u003c/h1\u003e\n\n\u003c/div\u003e"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732825_1318231057",
      "id": "paragraph_1753313083488_776384959",
      "dateCreated": "2025-07-28 00:15:32.825",
      "status": "READY"
    },
    {
      "text": "val stats \u003d dfNacidosCleanFinal\n\t.select(\n\t\tavg(\"sem_gest\").as(\"media\"),\n\t\tstddev(\"sem_gest\").as(\"desviacion_estandar\")\n\t).first\n\n\n\nval media \u003d stats.getAs[Double](\"media\")\nval desStand \u003d stats.getAs[Double](\"desviacion_estandar\")\nval umbralDesviacion \u003d 2.0\n\n\nval limiteInfDS \u003d media - umbralDesviacion * desStand\nval limiteSupDS \u003d media + umbralDesviacion * desStand\n\n\nval outliersDS \u003d dfNacidosCleanFinal\n\t.where($\"sem_gest\" \u003c limiteInfDS || $\"sem_gest\" \u003e limiteSupDS)\n\n\nval dfSinOutliersDS \u003d dfNacidosCleanFinal\n\t.where($\"sem_gest\" \u003e\u003d limiteInfDS \u0026\u0026 $\"sem_gest\" \u003c\u003d limiteSupDS)\n\n",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.825",
      "progress": 0,
      "config": {
        "tableHide": false,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionSupport": true,
          "completionKey": "TAB"
        },
        "colWidth": 12.0,
        "fontSize": 9.0,
        "editorHide": false,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mstats\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Row\u001b[0m \u003d [38.37647180379106,1.766618370681727]\n\u001b[1m\u001b[34mmedia\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 38.37647180379106\n\u001b[1m\u001b[34mdesStand\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 1.766618370681727\n\u001b[1m\u001b[34mumbralDesviacion\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 2.0\n\u001b[1m\u001b[34mlimiteInfDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 34.84323506242761\n\u001b[1m\u001b[34mlimiteSupDS\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 41.909708545154515\n\u001b[1m\u001b[34moutliersDS\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m \u003d [prov_insc: string, cant_insc: string ... 46 more fields]\n\u001b[1m\u001b[34mdfSinOutliersDS\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m \u003d [prov_insc: string, cant_insc: string ... 46 more fields]\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732825_1665253725",
      "id": "paragraph_1753313109386_121242217",
      "dateCreated": "2025-07-28 00:15:32.825",
      "status": "READY"
    },
    {
      "text": "val cuartiles \u003d dfNacidosCleanFinal.stat.approxQuantile(\n\"sem_gest\", Array(0.25, 0.75), 0.01 //los percentiles 0.25 y 0.75 para Q1 y Q3\n)\n\n\nval q1 \u003d cuartiles(0)\nval q3 \u003d cuartiles(1)\nval iqr \u003d q3 - q1\n\n\nval limiteInferiorIQR \u003d q1 - 1.5 * iqr\nval limiteSuperiorIQR \u003d q3 + 1.5 * iqr\n\n\nval outliersIQR \u003d dfNacidosCleanFinal.filter(\n\tcol(\"sem_gest\") \u003c limiteInferiorIQR || col(\"sem_gest\") \u003e limiteSuperiorIQR\n)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.825",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
