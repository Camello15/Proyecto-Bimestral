    },
    {
      "text": "val dfSinOutliersDS \u003d dfNacidosCleanFinal\r\n\t.where($\"apgar1\" \u003e\u003d limiteInfDS \u0026\u0026 $\"apgar1\" \u003c\u003d limiteSupDS)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.820",
      "progress": 0,
