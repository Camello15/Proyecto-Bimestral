    {
      "text": "%pyspark\r\n\r\nimport numpy as np\r\n\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT apgar1, apgar5, sem_gest\r\n  FROM dfApgarSemGest\r\n  WHERE sem_gest IS NOT NULL AND apgar1 IS NOT NULL AND apgar5 IS NOT NULL\r\n  AND sem_gest \u003e\u003d 22 AND sem_gest \u003c\u003d 42 -- Filtrar semanas de gestación típicas y válidas para un bebé viable\r\n\"\"\").toPandas()\r\n\r\ndf_tmp \u003d tmp.copy()\r\n\r\n# Calcular promedios APGAR 1 y APGAR 5 por semanas de gestación\r\ndf_avg_apgar_sem_gest \u003d df_tmp.groupby(\u0027sem_gest\u0027).agg(\r\n    apgar1_mean\u003d(\u0027apgar1\u0027, \u0027mean\u0027),\r\n    apgar5_mean\u003d(\u0027apgar5\u0027, \u0027mean\u0027)\r\n).reset_index()\r\n\r\n# Asegurarse de que las semanas de gestación estén ordenadas para el gráfico de líneas\r\ndf_avg_apgar_sem_gest \u003d df_avg_apgar_sem_gest.sort_values(\u0027sem_gest\u0027)\r\n\r\n# Preparar los datos para el gráfico de líneas (melt)\r\ndf_melted_apgar_sem_gest \u003d df_avg_apgar_sem_gest.melt(\r\n    id_vars\u003d[\u0027sem_gest\u0027],\r\n    value_vars\u003d[\u0027apgar1_mean\u0027, \u0027apgar5_mean\u0027],\r\n    var_name\u003d\u0027Momento APGAR\u0027,\r\n    value_name\u003d\u0027Puntaje Promedio\u0027\r\n)\r\n\r\n# Ajustar el nombre de las categorías de \u0027Momento APGAR\u0027 para la leyenda\r\ndf_melted_apgar_sem_gest[\u0027Momento APGAR\u0027] \u003d df_melted_apgar_sem_gest[\u0027Momento APGAR\u0027].replace({\r\n    \u0027apgar1_mean\u0027: \u0027APGAR 1\u0027,\r\n    \u0027apgar5_mean\u0027: \u0027APGAR 5\u0027\r\n})\r\n\r\nplt.figure(figsize\u003d(12, 7)) # Ajustar tamaño para que el eje X sea legible\r\n\r\n# Gráfico de Líneas: Promedio APGAR 1 y APGAR 5 por Semanas de Gestación\r\nsns.lineplot(data\u003ddf_melted_apgar_sem_gest, x\u003d\u0027sem_gest\u0027, y\u003d\u0027Puntaje Promedio\u0027, hue\u003d\u0027Momento APGAR\u0027, marker\u003d\u0027o\u0027, palette\u003d\u0027coolwarm\u0027)\r\nplt.xlabel(\u0027Semanas de Gestación\u0027)\r\nplt.ylabel(\u0027Puntaje Promedio APGAR\u0027)\r\nplt.title(\u0027Progresión del Puntaje Promedio APGAR (Minuto 1 a Minuto 5) por Semanas de Gestación\u0027)\r\nplt.xticks(np.arange(df_melted_apgar_sem_gest[\u0027sem_gest\u0027].min(), df_melted_apgar_sem_gest[\u0027sem_gest\u0027].max() + 1, 2)) # Marcas cada 2 semanas\r\nplt.ylim(0, 10) # Los puntajes APGAR van de 0 a 10\r\nplt.grid(True, linestyle\u003d\u0027--\u0027, alpha\u003d0.7)\r\nplt.legend(title\u003d\u0027Momento APGAR\u0027)\r\nplt.tight_layout()\r\nplt.show()",
      "user": "anonymous",
