      "jobName": "paragraph_1753661732824_1925931581",
      "id": "paragraph_1752713463333_349920897",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val cuartiles \u003d dfNacidosCleanFinal.stat.approxQuantile(\n\"talla\", Array(0.25, 0.75), 0.01 //los percentiles 0.25 y 0.75 para Q1 y Q3\n)",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "tableHide": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionSupport": true,
          "completionKey": "TAB"
        },
        "colWidth": 12.0,
        "fontSize": 9.0,
        "editorHide": false,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mcuartiles\u001b[0m: \u001b[1m\u001b[32mArray[Double]\u001b[0m \u003d Array(47.0, 50.0)\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_874006189",
      "id": "paragraph_1752713645010_2133677640",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val q1 \u003d cuartiles(0)\r\nval q3 \u003d cuartiles(1)\r\nval iqr \u003d q3 - q1",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[1m\u001b[34mq1\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 47.0\n\u001b[1m\u001b[34mq3\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 50.0\n\u001b[1m\u001b[34miqr\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m \u003d 3.0\n"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1753661732824_1952950184",
      "id": "paragraph_1752713664097_219892989",
      "dateCreated": "2025-07-28 00:15:32.824",
      "status": "READY"
    },
    {
      "text": "val limiteInferiorIQR \u003d q1 - 1.5 * iqr\r\nval limiteSuperiorIQR \u003d q3 + 1.5 * iqr",
      "user": "anonymous",
      "dateUpdated": "2025-07-28 00:15:32.824",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
