    {
      "text": "%pyspark\r\nimport numpy as np\r\n\r\ntmp \u003d spark.sql(\"\"\"\r\n  SELECT\r\n    grupo_edad_mad,\r\n    sexo,\r\n    peso,\r\n    talla\r\n  FROM dfFullWithBinnedAge\r\n  WHERE\r\n    grupo_edad_mad IS NOT NULL AND grupo_edad_mad !\u003d \u0027Sin Informacion Edad\u0027 AND\r\n    sexo IS NOT NULL AND sexo !\u003d \u0027Sin información\u0027 AND sexo !\u003d \u0027\u0027 AND\r\n    peso IS NOT NULL AND peso \u003e 0 AND -- Aseguramos que peso sea positivo para log\r\n    talla IS NOT NULL AND talla \u003e 0   -- Aseguramos que talla sea positivo para log\r\n\"\"\")\r\n\r\ndf_tmp_pandas \u003d tmp.toPandas()\r\n\r\n# Agrupar y calcular promedios (en escala lineal)\r\ndf_agg_linear \u003d df_tmp_pandas.groupby([\u0027grupo_edad_mad\u0027, \u0027sexo\u0027]).agg(\r\n    promedio_peso\u003d(\u0027peso\u0027, \u0027mean\u0027),\r\n    promedio_talla\u003d(\u0027talla\u0027, \u0027mean\u0027)\r\n).reset_index()\r\n\r\n\r\n# Gráfica 1: Peso Promedio\r\nplt.figure(figsize\u003d(10, 7))\r\nsns.barplot(data\u003ddf_agg_linear, x\u003d\u0027grupo_edad_mad\u0027, y\u003d\u0027promedio_peso\u0027, hue\u003d\u0027sexo\u0027, palette\u003d\u0027coolwarm\u0027)\r\nplt.ylabel(\"Peso Promedio (g)\")\r\nplt.xlabel(\"Grupo de Edad de la Madre\")\r\nplt.title(\"Peso Promedio al Nacer por Edad de la Madre y Sexo del Bebé\")\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\r\nplt.legend(title\u003d\u0027Sexo del Bebé\u0027)\r\nplt.tight_layout()\r\nplt.show()\r\n\r\n# Gráfica 2: Talla Promedio\r\nplt.figure(figsize\u003d(10, 7))\r\nsns.barplot(data\u003ddf_agg_linear, x\u003d\u0027grupo_edad_mad\u0027, y\u003d\u0027promedio_talla\u0027, hue\u003d\u0027sexo\u0027, palette\u003d\u0027viridis\u0027)\r\nplt.ylabel(\"Talla Promedio (cm)\")\r\nplt.xlabel(\"Grupo de Edad de la Madre\")\r\nplt.title(\"Talla Promedio al Nacer por Edad de la Madre y Sexo del Bebé\")\r\nplt.xticks(rotation\u003d45, ha\u003d\u0027right\u0027)\r\nplt.legend(title\u003d\u0027Sexo del Bebé\u0027)\r\nplt.tight_layout()\r\nplt.show()",
